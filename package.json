{
  "name": "locator-pilot",
  "version": "0.1.0",
  "description": "Pick any element and get a ready-to-use Playwright locator in C# or TypeScript. Paste a locator back in to find it on the page.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack": "node pack.mjs",
    "store:screenshots": "node store/capture.mjs",
    "test:e2e": "npm run build && playwright test",
    "version": "node scripts/sync-version.mjs && git add manifest.json CHANGELOG.md",
    "publish:store": "node scripts/publish-store.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
