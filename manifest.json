{
  "manifest_version": 3,
  "name": "Locator Pilot — Playwright Element Locators",
  "version": "0.1.0",
  "description": "Pick any element on a page and get a ready-to-use Playwright locator in C# or TypeScript. Paste a locator back in to find and highlight it.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
